// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(50)
  description String?      @db.VarChar(255)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  users       UserAccount[]

  @@map("role")
}

model DocumentType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  active    Boolean  @default(true)

  persons Person[]

  @@map("document_type")
}

model Person {
  id             String   @id @default(uuid()) @db.Uuid
  documentTypeId String   @map("document_type_id") @db.Uuid
  documentNumber String   @map("document_number") @db.VarChar(50)
  firstName      String?  @map("first_name") @db.VarChar(100)
  lastName       String?  @map("last_name") @db.VarChar(100)
  businessName   String?  @map("business_name") @db.VarChar(200)
  email          String   @unique @db.VarChar(150)
  phone          String   @db.VarChar(30)
  address        String   @db.VarChar(255)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  userAccount  UserAccount?
  customer     Customer?
  supplier     Supplier?

  @@unique([documentTypeId, documentNumber])
  @@map("person")
}

model UserAccount {
  personId                 String    @id @map("person_id") @db.Uuid
  password                 String?   @map("password_hash") @db.VarChar(255)
  roleId                   String    @map("role_id") @db.Uuid
  active                   Boolean   @default(true)
  mustChangePassword       Boolean   @default(true) @map("must_change_password")
  activationToken          String?   @unique @map("activation_token") @db.VarChar(255)
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at") @db.Timestamp(6)
  passwordResetToken       String?   @unique @map("password_reset_token") @db.VarChar(255)
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at") @db.Timestamp(6)
  lastLoginAt             DateTime? @map("last_login_at") @db.Timestamp(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  person            Person         @relation(fields: [personId], references: [id])
  role              Role           @relation(fields: [roleId], references: [id])
  branchAssignments UserBranch[]
  auditLogs         AuditLog[]
  createdImages     ProductImage[] @relation("ProductImageCreatedBy")
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]
  inventoryClosures  InventoryClosure[]
  sales              Sale[]

  @@map("user_account")
}

model Customer {
  personId  String   @id @map("person_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  person Person @relation(fields: [personId], references: [id])

  sales Sale[]

  @@map("customer")
}

model Supplier {
  personId       String   @id @map("person_id") @db.Uuid
  commercialName String?  @map("commercial_name") @db.VarChar(200)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  person    Person     @relation(fields: [personId], references: [id])
  purchases Purchase[]

  @@map("supplier")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  address   String   @db.VarChar(255)
  phone     String   @db.VarChar(30)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  userAssignments    UserBranch[]
  branchInventories  BranchInventory[]
  inventoryMovements InventoryMovement[] @relation("InventoryMovementDestinationBranch")
  originMovements    InventoryMovement[] @relation("InventoryMovementOriginBranch")
  inventoryClosures  InventoryClosure[]
  sales              Sale[]

  @@map("branch")
}

model UserBranch {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  assignmentDate DateTime  @map("assignment_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  active         Boolean   @default(true)

  userAccount UserAccount @relation(fields: [userId], references: [personId])
  branch      Branch      @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId, assignmentDate])
  @@map("user_branch")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.Uuid
  oldData   Json?    @map("old_data") @db.Json
  newData   Json?    @map("new_data") @db.Json
  reason    String   @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  userAccount UserAccount @relation(fields: [userId], references: [personId])

  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  products Product[]

  @@map("category")
}

model UnitMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  abreviation String @unique @db.VarChar(10)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  products Product[]

  @@map("unit_measure")
}

model PaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  salePayments SalePayment[]

  @@map("payment_method")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(150)
  referenceCode   String   @unique @map("reference_code") @db.VarChar(50)
  description     String?  @db.Text
  categoryId      String   @map("category_id") @db.Uuid
  unitOfMeasureId String   @map("unit_of_measure_id") @db.Uuid
  price           Decimal  @db.Decimal(12, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  category        Category         @relation(fields: [categoryId], references: [id])
  unitOfMeasure   UnitMeasure            @relation(fields: [unitOfMeasureId], references: [id])
  images          ProductImage[]
  inventories     BranchInventory[]
  movements       InventoryMovement[]
  purchaseDetails PurchaseDetail[]
  closureDetails  InventoryClosureDetail[]
  saleDetails     SaleDetail[]

  @@index([categoryId])
  @@index([unitOfMeasureId])
  @@map("product")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  storageKey String   @unique @map("storage_key") @db.VarChar(500)
  url        String   @db.Text
  fileName   String   @map("file_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt   @map("size_bytes")
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  product Product     @relation(fields: [productId], references: [id])
  creator UserAccount @relation("ProductImageCreatedBy", fields: [createdBy], references: [personId])

  @@index([productId], map: "idx_product_image_product_id")
  @@map("product_image")
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT_ENTRY
  ADJUSTMENT_EXIT
  TRANSFER
}

model BranchInventory {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Int      @default(0)
  minimumStock   Int      @default(0) @map("minimum_stock")
  expirationDate DateTime @map("expiration_date") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId, expirationDate])
  @@index([branchId])
  @@index([productId])
  @@map("branch_inventory")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  branchId       String?               @map("branch_id") @db.Uuid
  originBranchId String?               @map("origin_branch_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  movementType   InventoryMovementType @map("movement_type")
  quantity       Int
  observation    String?               @db.Text
  movementAt     DateTime              @default(now()) @map("movement_at") @db.Timestamp(6)
  saleId         String?               @map("sale_id") @db.Uuid
  purchaseId     String?               @map("purchase_id") @db.Uuid

  product        Product     @relation(fields: [productId], references: [id])
  branch         Branch?     @relation("InventoryMovementDestinationBranch", fields: [branchId], references: [id])
  originBranch   Branch?     @relation("InventoryMovementOriginBranch", fields: [originBranchId], references: [id])
  user           UserAccount @relation(fields: [userId], references: [personId])
  purchase       Purchase?   @relation(fields: [purchaseId], references: [id])
  sale           Sale?       @relation(fields: [saleId], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([originBranchId])
  @@index([userId])
  @@index([movementAt])
  @@index([movementType])
  @@index([saleId])
  @@map("inventory_movement")
}

enum PurchaseStatus {
  PENDING_RECEIPT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  purchaseNumber String         @unique @map("purchase_number") @db.VarChar(30)
  supplierId     String         @map("supplier_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  purchaseAt     DateTime       @default(now()) @map("purchase_at") @db.Timestamp(6)
  subtotal       Decimal        @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  observation    String?        @db.Text
  status         PurchaseStatus @default(PENDING_RECEIPT)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  supplier  Supplier            @relation(fields: [supplierId], references: [personId])
  user      UserAccount         @relation(fields: [userId], references: [personId])
  details   PurchaseDetail[]
  movements InventoryMovement[]

  @@index([supplierId])
  @@index([userId])
  @@index([purchaseAt])
  @@map("purchase")
}

model PurchaseDetail {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseId        String  @map("purchase_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  requestedQuantity Int     @map("requested_quantity")
  receivedQuantity  Int     @default(0) @map("received_quantity")
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal          Decimal @db.Decimal(12, 2)
  observation       String? @db.Text
  received          Boolean @default(false)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_detail")
}

enum InventoryClosureStatus {
  PENDING
  CONFIRMED
  NOT_CONFIRMED
}

model InventoryClosure {
  id          String                 @id @default(uuid()) @db.Uuid
  branchId    String                 @map("branch_id") @db.Uuid
  userId      String?                @map("user_id") @db.Uuid
  closureDate DateTime               @map("closure_date") @db.Date
  status      InventoryClosureStatus @default(PENDING)
  confirmed   Boolean                @default(false)
  locked      Boolean                @default(false)
  closedAt    DateTime?              @map("closed_at") @db.Timestamp(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamp(6)

  branch  Branch                  @relation(fields: [branchId], references: [id])
  user    UserAccount?            @relation(fields: [userId], references: [personId])
  details InventoryClosureDetail[]

  @@unique([branchId, closureDate])
  @@index([branchId])
  @@index([closureDate])
  @@map("inventory_closure")
}

model InventoryClosureDetail {
  id               String   @id @default(uuid()) @db.Uuid
  closureId        String   @map("closure_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  systemQuantity   Int      @map("system_quantity")
  physicalQuantity Int?     @map("physical_quantity")
  difference       Int?
  observation      String?  @db.Text

  closure InventoryClosure @relation(fields: [closureId], references: [id])
  product Product          @relation(fields: [productId], references: [id])

  @@unique([closureId, productId])
  @@index([closureId])
  @@index([productId])
  @@map("inventory_closure_detail")
}

enum SaleStatus {
  COMPLETED
  REVERSED
}

model Sale {
  id             String     @id @default(uuid()) @db.Uuid
  saleNumber     String     @map("sale_number") @db.VarChar(30)
  branchId       String     @map("branch_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  customerId     String?    @map("customer_id") @db.Uuid
  saleAt         DateTime   @default(now()) @map("sale_at") @db.Timestamp(6)
  subtotal       Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal    @map("tax_amount") @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  reversalReason String?    @map("reversal_reason") @db.Text
  reversedAt     DateTime?  @map("reversed_at") @db.Timestamp(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  branch    Branch              @relation(fields: [branchId], references: [id])
  user      UserAccount         @relation(fields: [userId], references: [personId])
  customer  Customer?           @relation(fields: [customerId], references: [personId])
  details   SaleDetail[]
  payments  SalePayment[]
  movements InventoryMovement[]

  @@unique([branchId, saleNumber])
  @@index([branchId])
  @@index([userId])
  @@index([customerId])
  @@index([saleAt])
  @@index([status])
  @@map("sale")
}

model SaleDetail {
  id             String  @id @default(uuid()) @db.Uuid
  saleId         String  @map("sale_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_detail")
}

model SalePayment {
  id              String   @id @default(uuid()) @db.Uuid
  saleId          String   @map("sale_id") @db.Uuid
  paymentMethodId String   @map("payment_method_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  reference       String?  @db.VarChar(100)
  paidAt          DateTime @default(now()) @map("paid_at") @db.Timestamp(6)

  sale          Sale          @relation(fields: [saleId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([saleId])
  @@index([paymentMethodId])
  @@map("sale_payment")
}