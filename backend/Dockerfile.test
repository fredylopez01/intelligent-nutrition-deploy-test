FROM node:22-alpine

WORKDIR /app

# Cliente de PostgreSQL para crear la base de datos de test al arrancar.
RUN apk add --no-cache postgresql-client

COPY package*.json ./

RUN npm ci

COPY prisma ./prisma
COPY prisma.config.ts ./
COPY tsconfig*.json ./
COPY nest-cli.json ./
COPY src ./src
COPY test ./test

RUN npx prisma generate

ENV NODE_ENV=test

# Corre primero los specs unitarios (config en package.json) y luego los e2e
# (test/jest-e2e.json, que exige DATABASE_URL_TEST).
CMD ["sh", "-c", "npm test && npm run test:e2e"]
