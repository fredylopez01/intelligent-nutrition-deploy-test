# URL base de la API backend
VITE_API_URL=http://localhost:3000

# Activa una sesión simulada en desarrollo mientras el login (TK-0293)
# no esté integrado. NUNCA debe estar en true en producción.
VITE_MOCK_SESSION=false

# Activa datos de usuarios simulados mientras el backend de /users
# no esté disponible. Ver src/services/users.service.ts
VITE_USE_MOCKS=false