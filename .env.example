# Variables usadas por Docker Compose.
POSTGRES_USER=intelligent_nutrition
POSTGRES_PASSWORD=change_me
POSTGRES_DB=intelligent_nutrition

DATABASE_URL=postgresql://intelligent_nutrition:change_me@localhost:5432/intelligent_nutrition?schema=public
# Dentro de Docker
DATABASE_URL_DOCKER=postgresql://intelligent_nutrition:change_me@postgres:5432/intelligent_nutrition?schema=public
SEED_ADMIN_PASSWORD=change_this_seed_admin_password
JWT_SECRET=change_this_development_jwt_secret
JWT_EXPIRES_IN=15m
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
BRAND_LOGO_URL=
ACTIVATION_TOKEN_EXPIRATION_MINUTES=
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# URL base de la API backend
VITE_API_URL=http://localhost:3000
# Activa una sesión simulada en desarrollo mientras el login (TK-0293)
# no esté integrado. NUNCA debe estar en true en producción.
VITE_MOCK_SESSION=false

# Activa datos de usuarios simulados mientras el backend de /users
# no esté disponible. Ver src/services/users.service.ts
VITE_USE_MOCKS=false