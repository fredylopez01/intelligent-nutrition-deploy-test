# Variables usadas por Docker Compose.
POSTGRES_USER=intelligent_nutrition
POSTGRES_PASSWORD=change_me
POSTGRES_DB=intelligent_nutrition

DATABASE_URL=postgresql://intelligent_nutrition:change_me@localhost:5432/intelligent_nutrition?schema=public
# Dentro de Docker
DATABASE_URL_DOCKER=postgresql://intelligent_nutrition:change_me@postgres:5432/intelligent_nutrition?schema=public
SEED_ADMIN_PASSWORD=change_this_seed_admin_password
JWT_SECRET=change_this_development_jwt_secret
JWT_EXPIRES_IN=15m
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
BRAND_LOGO_URL=
ACTIVATION_TOKEN_EXPIRATION_MINUTES=
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# URL base de la API backend
VITE_API_URL=http://localhost:3000
# Activa una sesión simulada en desarrollo mientras el login (TK-0293)
# no esté integrado. NUNCA debe estar en true en producción.
VITE_MOCK_SESSION=false

# Activa datos de usuarios simulados mientras el backend de /users
# no esté disponible. Ver src/services/users.service.ts
VITE_USE_MOCKS=false

# ============================================
# STORAGE (Cloudflare R2 - compatible S3)
# ============================================
# Endpoint de R2. Reemplaza <account-id> con tu Account ID de Cloudflare.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Nombre del bucket. Dev: products-images-dev | Prod: products-images-prod
STORAGE_BUCKET=products-images-dev
# Access Key ID del API Token de R2 (permisos Object Read & Write).
STORAGE_ACCESS_KEY=your-access-key-id
# Secret Access Key del API Token de R2.
STORAGE_SECRET_KEY=your-secret-access-key
# URL pública del CDN (dominio personalizado conectado al bucket).
# Dev: https://cdn-dev.tudominio.com | Prod: https://cdn.tudominio.com
STORAGE_PUBLIC_URL=https://cdn-dev.tudominio.com
# Región de R2 (siempre "auto").
STORAGE_REGION=auto
# Solo para MinIO local. En R2 siempre es "false".
STORAGE_FORCE_PATH_STYLE=false

# Max images allowed per product.
PRODUCT_IMAGE_LIMIT=5
# Signed upload URL expiration in seconds.
STORAGE_UPLOAD_URL_EXPIRES_IN=300